# ── Database (MySQL 8) ────────────────────────────────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=preckon
DATABASE_NAME=preckon_tenant

# ── Better Auth (tenant identity pool) ────────────────────────────────────────
# Generate a long random string (>=32 chars) for anything beyond local dev.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3100

# ── Service-to-service (the /internal surface: job callback, bootstrap, etc.) ──
INTERNAL_SERVICE_TOKEN=change-me-service-token

# ── The AI worker (stateless; NO DB access — trust boundary §5.1) ─────────────
# Core dispatches JobEnvelopes here; the worker calls back to CORE_URL.
WORKER_URL=http://localhost:4000
CORE_URL=http://localhost:3100

# ── Object storage for uploads (local filesystem in dev) ──────────────────────
FILE_STORAGE_DIR=./.uploads

# ── Seed ─────────────────────────────────────────────────────────────────────
# The demo owner's password. Required: the compose file refuses to start the
# seed without it, rather than shipping a known password in the repo.
TENANT_OWNER_PASSWORD=change-me

# ── AI ───────────────────────────────────────────────────────────────────────
# Read by the WORKER only; the app container never sees it.
ANTHROPIC_API_KEY=

# Whether a deterministic stub may stand in when Claude is unavailable.
#
# Leave this unset anywhere real. With NODE_ENV=production the worker refuses to
# substitute invented output for a failed AI call and fails the job instead — a
# fabricated bill that reports success is worse than no bill, because somebody
# prices work from it. Set it to true ONLY on a demo box that is meant to run
# without an API key.
DEMO_STUB_MODE=
