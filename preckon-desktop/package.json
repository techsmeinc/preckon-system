{
  "name": "preckon-desktop",
  "productName": "Preckon",
  "version": "1.0.0",
  "private": true,
  "description": "Preckon drawing workstation \u2014 opens and converts drawings on your own machine.",
  "author": "Preckon",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:win:zip": "electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.preckon.desktop",
    "productName": "Preckon",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/oda",
        "to": "oda",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
