{
  "name": "preckon-desktop",
  "productName": "Preckon",
  "version": "1.0.3",
  "private": true,
  "description": "Preckon drawing workstation \u2014 opens and converts drawings on your own machine.",
  "author": "Preckon",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dist": "electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "dist:win:zip": "npm run build:renderer && electron-builder --win zip",
    "build:renderer": "node build-renderer.mjs",
    "watch:renderer": "node build-renderer.mjs --watch"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "com.preckon.desktop",
    "productName": "Preckon",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "renderer/index.html",
      "renderer/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/oda",
        "to": "oda",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "dxf-parser": "^1.1.2"
  }
}
